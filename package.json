{
  "name": "agentkodex",
  "version": "1.0.4",
  "description": "The chat-first control plane for AI coding agents.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veganjoe966/Agentkodex.git"
  },
  "homepage": "https://github.com/Veganjoe966/Agentkodex#readme",
  "bugs": {
    "url": "https://github.com/Veganjoe966/Agentkodex/issues"
  },
  "bin": {
    "agentkodex": "bin/agentkodex.js"
  },
  "scripts": {
    "start": "node bin/agentkodex.js",
    "test": "node --test tests/*.test.js",
    "lint": "find bin src tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "typecheck": "find bin src tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "postinstall": "node scripts/postinstall.js",
    "quality": "npm run quality:gate",
    "quality:gate": "node bin/agentkodex.js quality check --json",
    "lintguard:check": "node bin/agentkodex.js lintguard check --local --json",
    "release": "npm run release:gate",
    "release:gate": "node bin/agentkodex.js release gate"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "coding-agent",
    "agent-runtime",
    "agent-ops",
    "audit",
    "governance",
    "security",
    "automation",
    "developer-tools"
  ]
}
