{
  "version": 2,
  "defaultAgent": "local",
  "defaultMode": "supervised",
  "requiredGates": ["lint", "test", "build"],
  "commandTimeoutMs": 1800000,
  "runtime": {
    "preferred": "cockpit",
    "pty": true,
    "sessionDaemon": false
  },
  "policy": {
    "approvalQueue": true,
    "redactSecrets": true,
    "blockDestructiveCommands": true
  },
  "agentguard": {
    "enabled": true,
    "required": false,
    "source": "../agentguard/Agentguard",
    "policyPath": ".agentkodex/agentguard-policy.yaml"
  },
  "lintguard": {
    "enabled": true,
    "url": "http://127.0.0.1:8001",
    "authRequired": true,
    "gates": ["lint", "typecheck"]
  },
  "agents": {
    "custom": {
      "kind": "custom",
      "description": "Example custom coding-agent command.",
      "commandTemplate": "my-agent --prompt-file {promptFile} --cwd {cwd}",
      "stdin": false
    }
  }
}
